---
import Layout from "@/layouts/main.astro"
---

<Layout>
  <section class="w-full py-20 sm:py-28 lg:py-32">
    <div class="mx-auto max-w-4xl px-4">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-light tracking-tighter text-amber-50">Oblig-3 Project</h1>
      <p class="mt-4 text-lg text-amber-100/80 font-light">
        This is the oblig-3 project page. Replace this content with your project details.
      </p>
      <a href="/" class="mt-8 inline-block text-sm font-light text-amber-300/90 hover:text-amber-200 hover:underline transition-all">
        Back to home
      </a>
    </div>
  </section>
</Layout>
