---
import Layout from "@/layouts/main.astro"
import HeroSection from "@/components/HeroSection.astro"
import ProjectCarousel from "@/components/ProjectCarousel"

const projects = [
  {
    id: 1,
    title: "Comparison Tool",
    description: "A Comparison Tool made to help researchers make and conduct studies. Researchers could choose between stimuli in form of audio, video, images or documents and create comparisons with different rating scales. The tool also had a dashboard for researchers to view and analyze the results of their studies.",
    image: "/gustav-grimsmo-øines-prosjekt-1.png",
    alt: "Project one"
  },
  {
    id: 2,
    title: "srollytelling",
    description: "A scrollytelling project that is based upon FN's sustainable development goals. In this project we chose goal nr.14 - Life Below Water, and tells a story of how the plastic you use in your daily life could end up in the bottom of the ocean floor.",
    image: "/gustav-grimsmo-øines-prosjekt-2.png",
    alt: "Project Beta"
  },
  {
    id: 3,
    title: "Worldy",
    description: "Wordly is a Interactive globe system that we created using Express.js, React and Node-RED. Together with a built in Raspberry Pi with a gyropscope and a 3D printed globe-skeleton we were able to display inventions from each country on the globe using Google maps API for coordinates, our own API for inventions and OpenAI API to create quizzes in real time for the users.",
    image: "/20251209_110242.jpg",
    alt: "Project Gamma"
  }
]
---

<Layout>
  <HeroSection />
  <section id="projects" class="w-full py-20 sm:py-28 lg:py-32 relative overflow-hidden">
    <div class="mx-auto max-w-3xl px-4 relative z-10">
      <div class="mb-12 sm:mb-16 lg:mb-20 space-y-4 sm:space-y-6 sm:-ml-10 lg:-ml-50">
        <h2 class="text-3xl sm:text-4xl md:text-6xl font-light tracking-tighter text-amber-50">My Projects</h2>
    </div>
      
      <!-- Project Cards Carousel -->
      <div class="px-4 sm:px-8 lg:px-20">
        <ProjectCarousel client:load projects={projects} />
      </div>
    </div>
  </section>
  <section id="contact" class="w-full py-20 sm:py-28 lg:py-32">
    <div class="mx-auto max-w-5xl px-4">
      <div class="mb-12 sm:mb-16 lg:mb-20 space-y-6 sm:space-y-8 text-center">
        <h2 class="text-3xl sm:text-4xl md:text-6xl font-light tracking-tighter text-amber-50">Follow me!</h2>
      </div>
      
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <div class="group rounded-lg border border-amber-700/30 bg-gradient-to-br from-amber-900/50 to-amber-950/60 p-8 backdrop-blur-sm hover:border-amber-600/50 transition-all duration-500">
          <div class="space-y-5">
            <svg class="w-8 h-8 text-amber-400/70 group-hover:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <h3 class="text-xl font-light text-amber-50 group-hover:text-amber-100 transition-colors">Gmail</h3>
            <p class="text-amber-100/75 font-light">Send me a message and I'll get back shortly.</p>
            <a href="mailto:gussarosama2@gmail.com" class="inline-block text-sm font-light text-amber-400/80 hover:text-amber-400 hover:underline transition-all">gussarosama2@gmail.com</a>
          </div>
        </div>
        
        <div class="group rounded-lg border border-amber-700/30 bg-gradient-to-br from-amber-900/50 to-amber-950/60 p-8 backdrop-blur-sm hover:border-amber-600/50 transition-all duration-500">
          <div class="space-y-5">
            <svg class="w-8 h-8 text-amber-400/70 group-hover:text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"></path></svg>
            <h3 class="text-xl font-light text-amber-50 group-hover:text-amber-100 transition-colors">LinkedIn</h3>
            <p class="text-amber-100/75 font-light">Connect on LinkedIn to stay updated.</p>
            <a href="https://www.linkedin.com/in/gustav-grimsmo-%C3%B8ines-27a14a394/" target="_blank" rel="noreferrer" class="inline-block text-sm font-light text-amber-400/80 hover:text-amber-400 hover:underline transition-all">Visit profile</a>
          </div>
        </div>
        
        <div class="group rounded-lg border border-amber-700/30 bg-gradient-to-br from-amber-900/50 to-amber-950/60 p-8 backdrop-blur-sm hover:border-amber-600/50 transition-all duration-500">
          <div class="space-y-5">
            <svg class="w-8 h-8 text-amber-400/70 group-hover:text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v 3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>
            <h3 class="text-xl font-light text-amber-50 group-hover:text-amber-100 transition-colors">GitHub</h3>
            <p class="text-amber-100/75 font-light">Check out my projects and work.</p>
            <a href="https://github.com/bayakazama" target="_blank" rel="noreferrer" class="inline-block text-sm font-light text-amber-400/80 hover:text-amber-400 hover:underline transition-all">View repos</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
